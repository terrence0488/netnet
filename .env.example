# Every environment variable the code reads. Names only, never values (CONVENTIONS §7).
# Locally, copy to .env.local (gitignored). On Vercel, set them per environment.

# Set by Vercel: production | preview | development. Only "production" relaxes log() checks.
VERCEL_ENV=
# Set by Vercel: the deployed commit. Shortened, it is every analytics event's app_version
# ("dev" when unset).
VERCEL_GIT_COMMIT_SHA=
# Set by Vercel: a deployment's own host, and a preview's branch host. Without PUBLIC_ORIGIN, the
# origin is https:// and the branch host, else the deployment host, else http://localhost:5173.
VERCEL_URL=
VERCEL_BRANCH_URL=

# Origin (architecture §5.2): https://‹domain›, with no trailing slash. Better Auth's base URL,
# the links in emails, and the only origin a production request may come from.
PUBLIC_ORIGIN=

# Accounts (architecture §8): signs session cookies and verification links. Random, at least 32
# characters (`openssl rand -hex 32`), per environment. Required on every deployment; a local run
# without it makes one per process, so local sessions end when the API restarts.
BETTER_AUTH_SECRET=

# Accounts: providers (architecture §8). Google's OAuth client (F17), and Apple's Services ID,
# team id, key id and private key (F18). A provider with any value absent is cleanly unavailable:
# its button hides (see VITE_AUTH_* below) and its endpoints answer "not set up". The private key
# keeps its newlines (or `\n` escapes, when pasted as one line).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Email (architecture §7.10): Resend's API key and the sender, such as NetNet <hello@‹domain›>.
# Without both, nothing is sent: production fails each send (and logs it); elsewhere every email
# is captured, logged without its address or content.
RESEND_API_KEY=
EMAIL_FROM=
# Previews and local runs only: the addresses that get real email, separated by commas. Every
# other address is captured instead.
EMAIL_PREVIEW_ALLOW=

# The daily health alert's address (architecture §9.3, F25): the Founder's inbox, in Vercel
# Production only. Without it the check reports `unreadable_ops_email` and sends nothing — no
# crash, no email attempt — so the gap is visible in the run instead.
OPS_EMAIL=

# Local runs only
# Port of the API in `pnpm dev` (default 8787); the web dev server proxies to it.
API_PORT=
# Port of e2e/server.ts, the built app for Playwright (default 3100).
PORT=
# Run the E2E suite against a deployed URL instead of the local build.
E2E_BASE_URL=

# Database (architecture §6.1, §9.1)
# The app's connection: netnet_app through the pooler (Neon's "-pooler" host). Never the owner's.
# For `pnpm test:int` it is instead a Postgres superuser on a local or CI server: the suites build
# their own databases and roles.
DATABASE_URL=
# The owner's direct connection (netnet_owner, no pooler), for `pnpm db:bootstrap` and
# `pnpm db:migrate` only. In CI and production only the migration step holds it.
DATABASE_OWNER_URL=
# netnet_app's password, which `pnpm db:bootstrap` sets: 32 to 128 letters and digits
# (`openssl rand -hex 32`), because it goes inside DATABASE_URL.
NETNET_APP_DB_PASSWORD=

# Metrics (architecture §6.1, §10; P4-T3). DATABASE_METRICS_URL is netnet_metrics's connection:
# SELECT on `analytics` and nothing else. `pnpm db:bootstrap` gives the role login and
# NETNET_METRICS_DB_PASSWORD when that is set; unset, the role is nologin. `pnpm metrics` reads
# both, and METRICS_EXCLUDE_USERS is the comma-separated usr_ ids to omit from every reading (the
# probe account, ops/probe.md); never commit the ids.
DATABASE_METRICS_URL=
NETNET_METRICS_DB_PASSWORD=
METRICS_EXCLUDE_USERS=

# The daily health check (`pnpm health`, architecture §9.3, §9.4; P4-T4): Neon's consumption API
# key and the production project's id. Both are held by GitHub Actions (the secret NEON_API_KEY
# and the variable NEON_PROD_PROJECT_ID, F7), never by the function. The command also needs
# DATABASE_METRICS_URL above, and post with PUBLIC_ORIGIN and CRON_SECRET.
NEON_API_KEY=
NEON_PROD_PROJECT_ID=

# Cron (architecture §9.3): every /api/cron/* route requires `Authorization: Bearer $CRON_SECRET`,
# which the GitHub Actions schedules send to production from the CRON_SECRET repository secret
# (the same value as Vercel's Production). Without it every cron call is refused. Random, at
# least 32 characters (`openssl rand -hex 32`), per environment.
CRON_SECRET=

# Reminders (architecture §7.10, F19): signs the reminder's open and unsubscribe links (HMAC).
# Random, at least 32 characters (`openssl rand -hex 32`), per environment. Until the Founder
# sets it, tokens neither mint nor verify: no reminder goes and every link is refused.
LINK_SIGNING_SECRET=

# Web push (architecture §7.10, F19): the VAPID key pair and contact, one pair per environment
# (`npx web-push generate-vapid-keys`). The public key is served by
# GET /api/notifications/vapid-key; the private key signs every push. Until the Founder sets all
# three, everything push-related fails closed: no subscription is saved and reminders go by email.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Who to contact about these pushes: a `mailto:` address or an https: URL.
VAPID_SUBJECT=

# Errors (architecture §10): Sentry's DSN, per project. Without it the function's errors stay in
# the log and the web app's in the console. Set on Vercel (Production and Preview), never locally.
SENTRY_DSN=
# Baked into the web build (`apps/web/src/sentry.ts`).
VITE_SENTRY_DSN=
# Baked into the web build (`apps/web/src/api/auth.ts`): `1` shows each provider's official
# button, anything else hides it. Set alongside that provider's secrets above; a button whose
# secrets are missing says it is not available when tapped.
VITE_AUTH_GOOGLE=
VITE_AUTH_APPLE=

# Smoke tests (`pnpm smoke --origin <url>`): the default origin when the flag is absent.
SMOKE_ORIGIN=

# The MCP probe (`pnpm probe --origin <url>`, `ops/probe.md`): the origin, the probe client's id,
# and its current refresh token (every run rotates it). Held by the `production` GitHub
# environment, never here with values.
PROBE_ORIGIN=
PROBE_CLIENT_ID=
PROBE_REFRESH_TOKEN=

# Names held outside any shell, for reference (never values, anywhere):
# - GitHub environment `production`: DATABASE_OWNER_URL, DATABASE_URL, NETNET_APP_DB_PASSWORD,
#   PROBE_CLIENT_ID, PROBE_REFRESH_TOKEN, BACKUP_PUBLIC_KEY (the age public key, F14).
# - GitHub repository secrets: VERCEL_TOKEN, VERCEL_PROJECT_ID, NEON_API_KEY,
#   NETNET_APP_DB_PASSWORD_PREVIEW, PROBE_SECRETS_TOKEN (writes the rotated token back, F15),
#   NETNET_METRICS_DB_PASSWORD_PROD, DATABASE_METRICS_URL, METRICS_EXCLUDE_USERS (F24).
# - GitHub variables: PUBLIC_ORIGIN, NEON_PREVIEW_PROJECT_ID, NEON_PROD_PROJECT_ID.
# - Vercel Production: OPS_EMAIL (the health alert's address, F25); SENTRY_DSN, VITE_SENTRY_DSN,
#   and the app's own variables in Production and Preview.
