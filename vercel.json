{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "regions": ["sin1"],
  "git": { "deploymentEnabled": false },
  "crons": [
    { "path": "/api/cron/fx", "schedule": "0 17 * * *" },
    { "path": "/api/cron/daily", "schedule": "0 1 * * *" }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/mcp", "destination": "/api" },
    { "source": "/.well-known/(.*)", "destination": "/api" },
    { "source": "/app", "destination": "/app/index.html" },
    { "source": "/app/(.*)", "destination": "/app/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://*.ingest.sentry.io https://*.ingest.de.sentry.io; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'"
        },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    },
    {
      "source": "/(api|api/.*|mcp|\\.well-known/.*)",
      "headers": [{ "key": "Cache-Control", "value": "private, no-store" }]
    },
    {
      "source": "/(|index\\.html|app|app/(?!assets/).*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/(assets|app/assets)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
