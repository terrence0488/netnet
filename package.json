{
  "name": "netnet",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": "22.23.4"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @netnet/api --filter @netnet/web --filter @netnet/landing dev",
    "build": "pnpm --filter @netnet/landing build && pnpm --filter @netnet/web build && pnpm --filter @netnet/api build && pnpm --silent content:images",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --no-bail typecheck && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project '!integration'",
    "test:int": "vitest run --project integration --passWithNoTests",
    "test:e2e": "playwright test",
    "content:check": "tsx scripts/content-check.ts",
    "content:images": "tsx scripts/content-images.ts",
    "content:publish": "tsx scripts/content-publish.ts",
    "db:bootstrap": "tsx scripts/db-bootstrap.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:generate": "tsx scripts/db-generate.ts",
    "demo:load": "tsx scripts/demo-load.ts",
    "m12": "tsx ops/m12/src/index.ts",
    "fx:backfill": "tsx scripts/fx-backfill.ts",
    "metrics": "tsx scripts/metrics.ts",
    "smoke": "tsx scripts/smoke.ts",
    "probe": "tsx scripts/probe.ts"
  },
  "dependencies": {
    "@netnet/api": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@hono/node-server": "2.1.5",
    "@netnet/contracts": "workspace:*",
    "@netnet/core": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vercel": "62.7.0",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "overrides": {
      "better-call": "1.4.4",
      "vite@<8.3.3": "8.3.5",
      "esbuild@<0.25.0": "0.25.12",
      "zod@>=4.6.0 <4.6.6": "4.6.7"
    }
  }
}
