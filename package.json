{
  "name": "netnet",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @netnet/api --filter @netnet/web --filter @netnet/landing dev",
    "build": "pnpm --filter @netnet/landing build && pnpm --filter @netnet/web build && pnpm --filter @netnet/api build",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r --no-bail typecheck && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project '!integration'",
    "test:int": "vitest run --project integration --passWithNoTests",
    "test:e2e": "playwright test",
    "content:check": "tsx scripts/content-check.ts",
    "content:publish": "tsx scripts/content-publish.ts",
    "db:bootstrap": "tsx scripts/db-bootstrap.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:generate": "tsx scripts/db-generate.ts",
    "fx:backfill": "tsx scripts/fx-backfill.ts"
  },
  "dependencies": {
    "@netnet/api": "workspace:*"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@hono/node-server": "2.1.3",
    "@netnet/contracts": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "5.0.3",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vercel": "62.1.0",
    "vitest": "5.0.3"
  }
}
