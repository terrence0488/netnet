# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Database backups, encrypted or not — never commit
*.age
restore.sql

# Dependencies
node_modules/
.pnpm-store/
.venv/
__pycache__/

# Build output
dist/
build/
.next/
out/

# Logs & OS noise
*.log
npm-debug.log*
.DS_Store

# Editor
.idea/
.vscode/

# Local agent settings (shared .claude/ project files still commit)
.claude/settings.local.json

# Mockups contain the Founder's real financial data — keep them local, never commit
docs/reference/mockups/*.png
docs/reference/mockups/*.jpg
docs/reference/mockups/*.jpeg
docs/reference/mockups/*.webp
docs/reference/mockups/*.gif
docs/reference/mockups/*.pdf

# Mockups/screenshots dropped anywhere else — same rule, they may carry real data
/mockups/
**/mockups/*.png
**/mockups/*.jpg
**/mockups/*.jpeg
**/mockups/*.webp

# Vercel CLI and test output
.vercel/
coverage/
playwright-report/
test-results/

# M12 harness runs (ops/m12): transcripts, scores and the blind sheet stay local; only the report
# of a real run is committed, and the folder itself must be unignored for that to work.
ops/m12/runs/**
!ops/m12/runs/**/
!ops/m12/runs/**/report.md
