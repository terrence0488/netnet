{
  "name": "@netnet/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./vercel": {
      "types": "./src/vercel.ts",
      "default": "./dist/vercel.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "build": "esbuild src/vercel.ts --bundle --platform=node --format=esm --target=node22 --sourcemap --outfile=dist/vercel.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@netnet/contracts": "workspace:*",
    "hono": "4.13.12"
  },
  "devDependencies": {
    "@hono/node-server": "2.1.3",
    "tsx": "4.23.15",
    "@types/node": "22.20.4",
    "typescript": "6.0.3",
    "esbuild": "0.28.2"
  }
}
