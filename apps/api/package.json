{
  "name": "@netnet/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./vercel": {
      "types": "./src/vercel.ts",
      "default": "./dist/vercel.js"
    },
    "./content/fx-sync": "./src/content/fx-sync.ts",
    "./content/publish": "./src/content/publish.ts",
    "./db/bootstrap": "./src/db/bootstrap.ts",
    "./db/client": "./src/db/client.ts",
    "./db/fx-rates": "./src/db/fx-rates.ts",
    "./db/migrate": "./src/db/migrate.ts",
    "./db/seed": "./src/db/seed.ts"
  },
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "build": "esbuild src/vercel.ts --bundle --platform=node --format=esm --target=node22 --sourcemap --external:pg-native \"--banner:js=import { createRequire as netnetCreateRequire } from 'node:module'; const require = netnetCreateRequire(import.meta.url);\" --outfile=dist/vercel.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@netnet/contracts": "workspace:*",
    "@netnet/core": "workspace:*",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.12",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@hono/node-server": "2.1.3",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
