{
  "name": "@netnet/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./vercel": {
      "types": "./src/vercel.ts",
      "default": "./dist/vercel.js"
    },
    "./content/fx-sync": "./src/content/fx-sync.ts",
    "./content/publish": "./src/content/publish.ts",
    "./db/bootstrap": "./src/db/bootstrap.ts",
    "./db/client": "./src/db/client.ts",
    "./db/demo": "./src/db/demo.ts",
    "./db/fx-rates": "./src/db/fx-rates.ts",
    "./db/migrate": "./src/db/migrate.ts",
    "./db/seed": "./src/db/seed.ts"
  },
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "build": "esbuild src/vercel.ts --bundle --platform=node --format=esm --target=node22 --sourcemap --external:pg-native \"--banner:js=import { createRequire as netnetCreateRequire } from 'node:module'; const require = netnetCreateRequire(import.meta.url);\" --outfile=dist/vercel.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.12",
    "@better-auth/core": "1.7.12",
    "@better-auth/mcp": "1.7.12",
    "@better-auth/oauth-provider": "1.7.12",
    "@better-auth/utils": "0.5.0",
    "@modelcontextprotocol/server": "2.3.1",
    "@netnet/contracts": "workspace:*",
    "@netnet/core": "workspace:*",
    "@netnet/tokens": "workspace:*",
    "@sentry/node": "11.8.0",
    "better-auth": "1.7.12",
    "better-call": "1.4.4",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "jose": "6.2.13",
    "pg": "8.23.1",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/web-push": "3.6.4",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
